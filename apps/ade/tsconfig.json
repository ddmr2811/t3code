{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // Deep-merged with tsconfig.base.json. The remote HTTP client wraps the browser's fetch;
        // the ghostty runtime shared with apps/web logs libghostty's messages to the console.
        "diagnosticSeverity": { "globalFetch": "off", "globalConsole": "off" }
      }
    ]
  },
  "include": ["src", "vite.config.ts"]
}
